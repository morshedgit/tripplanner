        const tripId = clientState.activeTrip?.id;
        const input = document.getElementById(`chk-input-${chkId}`);
        const itemTitle = input ? input.value.trim() : '';
        if (!tripId || !itemTitle) return;

        try {
          const res = await fetch(`/api/v1/trips/${tripId}/checklists`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ checklist_id: chkId, title: itemTitle }),
          });
          if (res.ok) {
            showToast(`Added "${itemTitle}" to ${chkTitle}`);
            await persistSession({
              event_summary: `Added "${itemTitle}" to ${chkTitle}`,
              active_tab: 'checklists',
              actor: 'ui',
            });
            setTimeout(() => refreshWorkspaceDom(), 300);
          } else {
            await submitChatMessage(`Add ${itemTitle} to ${chkTitle}`);
          }
        } catch {
          await submitChatMessage(`Add ${itemTitle} to ${chkTitle}`);
        }
      }

      // 13. Conversational Assistant Handler
      async function sendPrompt(text) {
        const input = document.getElementById('chatInput');
        if (input) input.value = text;
        await submitChatMessage(text);
      }

      async function handleChatSubmit(e) {
        e.preventDefault();
        const input = document.getElementById('chatInput');
        const text = input.value.trim();
        if (!text) return;
        input.value = '';
        await submitChatMessage(text);
      }

      async function submitChatMessage(text) {
        const container = document.getElementById('chatMessages');

        const userDiv = document.createElement('div');
        userDiv.className = 'chat-bubble chat-bubble-user';
        userDiv.innerText = text;
        container.appendChild(userDiv);
        container.scrollTop = container.scrollHeight;

        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'chat-bubble chat-bubble-assistant';
        loadingDiv.innerHTML = '<em>Thinking and updating itinerary...</em>';
        container.appendChild(loadingDiv);
        container.scrollTop = container.scrollHeight;

        try {
          const res = await fetch('/api/v1/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              trip_id: clientState.activeTrip ? clientState.activeTrip.id : undefined,
              message: text,
              actor: 'chat',
            }),
          });

          const data = await res.json();
          container.removeChild(loadingDiv);

          const assistantDiv = document.createElement('div');
          assistantDiv.className = 'chat-bubble chat-bubble-assistant';

          let badgesHtml = '';
          if (data.actions_taken && data.actions_taken.length > 0) {
            badgesHtml = data.actions_taken
              .map((a) => `<div class="tool-badge">${BOLT_SVG_INLINE} <span>${a.tool}</span></div>`)
              .join(' ');
          }

          const formattedReply = (data.reply || '')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/•/g, '<br/>•')
            .replace(/\n\n/g, '<br/><br/>')
            .replace(/\n/g, '<br/>');

          assistantDiv.innerHTML = `${badgesHtml}<div>${formattedReply}</div>`;
          container.appendChild(assistantDiv);
          container.scrollTop = container.scrollHeight;

          if (data.session_state) {
            currentVersion = data.session_state.state_version;
            updateSessionBarUi(data.session_state);
          }

          if (data.trip_id && (!clientState.activeTrip || clientState.activeTrip.id !== data.trip_id)) {
            setTimeout(() => {
              refreshWorkspaceDom(data.trip_id);
            }, 600);
            return;
          }

          if (data.actions_taken && data.actions_taken.length > 0) {
            setTimeout(() => {
              refreshWorkspaceDom();
            }, 600);
          }
        } catch (err) {
          container.removeChild(loadingDiv);
          const errorDiv = document.createElement('div');
          errorDiv.className = 'chat-bubble chat-bubble-assistant';
          errorDiv.style.color = '#ef4444';
          errorDiv.innerText = `Error: ${err.message}`;
          container.appendChild(errorDiv);
        }
      }

      // 14. Real-Time Background Live Sync Loop (1.2s Polling)
      async function pollLiveSync() {
        if (isSyncing) return;
        isSyncing = true;
        try {
          let updated = false;
          let summary = '';
          let targetTripId = null;

          // 1. Check /api/v1/events?since_version=N
          const evRes = await fetch(`/api/v1/events?since_version=${currentVersion}`);
          if (evRes.ok) {
            const evData = await evRes.json();
            const events = evData.events || [];
            const newestEvent = events[0] || null;
            const oldestEvent = events[events.length - 1] || null;
            const bestEvent =
              newestEvent && oldestEvent
                ? (newestEvent.state_version >= oldestEvent.state_version ? newestEvent : oldestEvent)
                : newestEvent;

            const candidateVersion = Math.max(
              evData.current_version || 0,
              evData.latest_version || 0,
              bestEvent?.state_version || 0
            );

            if (candidateVersion > currentVersion) {
              currentVersion = candidateVersion;
              summary =
                bestEvent?.summary ||
                evData.session?.last_event_summary ||
                evData.last_event_summary ||
                'AGY workspace update';
              targetTripId = evData.session?.active_trip_id || bestEvent?.trip_id || null;
              if (evData.session) {
                if (evData.session.active_tab) {
                  const normTab = evData.session.active_tab === 'bookings' ? 'reservations' : evData.session.active_tab;
                  saveUiState('activeTab', normTab);
                }
                if (evData.session.active_day_number !== undefined) saveUiState('activeDay', evData.session.active_day_number);
                if (evData.session.selected_stop_id !== undefined) saveUiState('selectedStopId', evData.session.selected_stop_id);
              }
              updated = true;
            }
          } else {
            // Fallback to /api/v1/session
            const sessRes = await fetch('/api/v1/session');
            if (sessRes.ok) {
              const sData = await sessRes.json();
              const sess = sData.session || sData;
              if (sess.state_version && sess.state_version > currentVersion) {
                currentVersion = sess.state_version;
                summary = sess.last_event_summary || 'AGY workspace update';
                targetTripId = sess.active_trip_id || null;
                if (sess.active_tab) {
                  const normTab = sess.active_tab === 'bookings' ? 'reservations' : sess.active_tab;
                  saveUiState('activeTab', normTab);
                }
                if (sess.active_day_number !== undefined) saveUiState('activeDay', sess.active_day_number);
                if (sess.selected_stop_id !== undefined) saveUiState('selectedStopId', sess.selected_stop_id);
                updated = true;
              }
            }
          }

          if (updated) {
            showToast(`Live Update from AGY: ${summary}`);
            updateSessionBarUi({ state_version: currentVersion, last_event_summary: summary });
            const urlTripId = new URLSearchParams(window.location.search).get('trip_id');
            if (targetTripId && (targetTripId !== clientState.activeTrip?.id || urlTripId !== targetTripId)) {
              refreshWorkspaceDom(targetTripId);
            } else {
              refreshWorkspaceDom();
            }
          }
        } catch {
          // Silent catch for background poll
        } finally {
          isSyncing = false;
        }
      }

      // Start background poll every 1.2s
      setInterval(pollLiveSync, 1200);

      // 15. Export Helper (links directly to valid REST export routes)
      function exportData(format) {
        if (!clientState.activeTrip) return;
        const tripId = clientState.activeTrip.id;
        if (format === 'markdown') {
          window.open(`/api/v1/trips/${tripId}/export/markdown`, '_blank');
        } else if (format === 'ical' || format === 'ics') {
          window.open(`/api/v1/trips/${tripId}/export/ics`, '_blank');
        } else if (format === 'csv') {
          window.open(`/api/v1/trips/${tripId}/export/expenses.csv`, '_blank');
        }
      }

      // Explicitly expose all UI event handlers on window for inline onclick/onsubmit attributes
      window.handleTabClick = handleTabClick;
      window.selectStop = selectStop;
      window.sendPrompt = sendPrompt;
      window.handleChatSubmit = handleChatSubmit;
      window.handleTripChange = handleTripChange;
      window.handleDayFilterChange = handleDayFilterChange;
      window.handleInlineAddStop = handleInlineAddStop;
      window.focusInlineAddStop = focusInlineAddStop;
      window.handleInlineAddWishlist = handleInlineAddWishlist;
      window.handleOptimizeDayRoute = handleOptimizeDayRoute;
      window.handleDeleteStop = handleDeleteStop;
      window.handleMoveStop = handleMoveStop;
      window.handleScheduleWishlistStop = handleScheduleWishlistStop;
      window.handleInlineLogExpense = handleInlineLogExpense;
      window.handleInlineAddReservation = handleInlineAddReservation;
      window.handleToggleChecklist = handleToggleChecklist;
      window.handleInlineAddChecklistItem = handleInlineAddChecklistItem;
      window.highlightMapMarker = highlightMapMarker;
      window.unhighlightMapMarker = unhighlightMapMarker;
      window.exportData = exportData;
      window.toggleNewTripPanel = toggleNewTripPanel;
      window.handleCreateNewTrip = handleCreateNewTrip;
      window.toggleAddReservationPanel = toggleAddReservationPanel;
      window.handleDayPillSelect = handleDayPillSelect;
      window.refreshWorkspaceDom = refreshWorkspaceDom;

      // Mount on DOM ready
      document.addEventListener('DOMContentLoaded', () => {
        initMap();

        // Sync localStorage from server session state (do not overwrite AGY session state from stale localStorage)
        if (clientState.session) {
          if (clientState.session.active_tab) {
            const normTab = clientState.session.active_tab === 'bookings' ? 'reservations' : clientState.session.active_tab;
            saveUiState('activeTab', normTab);
          }
          if (clientState.session.active_day_number !== undefined) saveUiState('activeDay', clientState.session.active_day_number);
          if (clientState.session.selected_stop_id !== undefined) saveUiState('selectedStopId', clientState.session.selected_stop_id);
        }
      });
    </script>
  </body>
</html>
