      // 9b. Move Stop & Schedule Wishlist Stop (calls /api/v1/mcp move_stop directly)
      async function handleMoveStop(stopId, stopName, targetDayNumber, targetSectionType = 'afternoon') {
        const tripId = clientState.activeTrip?.id;
        if (!tripId || !stopId) return;

        try {
          const isWishlist = targetDayNumber === 'wishlist';
          const res = await fetch('/api/v1/mcp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              jsonrpc: '2.0',
              id: Date.now(),
              method: 'tools/call',
              params: {
                name: 'move_stop',
                arguments: {
                  trip_id: tripId,
                  stop_id: stopId,
                  target_day_number: isWishlist ? undefined : parseInt(targetDayNumber, 10),
                  target_section_type: isWishlist ? 'wishlist' : targetSectionType,
                },
              },
            }),
          });
          if (res.ok) {
            showToast(`Moved "${stopName}" to ${isWishlist ? 'Wishlist' : 'Day ' + targetDayNumber + ' (' + targetSectionType + ')'}`);
            await persistSession({
              event_summary: `Moved "${stopName}" to ${isWishlist ? 'Wishlist' : 'Day ' + targetDayNumber + ' (' + targetSectionType + ')'}`,
              selected_stop_id: stopId,
              active_day_number: isWishlist ? null : parseInt(targetDayNumber, 10),
              actor: 'ui',
            });
            setTimeout(() => refreshWorkspaceDom(), 300);
          } else {
            await submitChatMessage(`Move ${stopName} to ${isWishlist ? 'wishlist' : 'Day ' + targetDayNumber + ' ' + targetSectionType}`);
          }
        } catch {
          await submitChatMessage(`Move ${stopName} to ${targetDayNumber}`);
        }
      }

      async function handleScheduleWishlistStop(stopId, stopName, targetDayNumber = 1, targetSectionType = 'morning') {
        return handleMoveStop(stopId, stopName, targetDayNumber, targetSectionType);
      }

