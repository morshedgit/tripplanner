            showToast(`Created trip "${newTrip.title}"`);
            await persistSession({
              active_trip_id: newTrip.id,
              active_day_number: 1,
              active_tab: 'itinerary',
              selected_stop_id: null,
              event_summary: `Created new trip "${newTrip.title}"`,
              actor: 'ui',
